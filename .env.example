# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Optional attribution headers sent to OpenRouter.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Golf Swing Analyser

# Required for production AI quotas and response caching. The Upstash Vercel
# integration may provide the equivalent KV_REST_API_URL/KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used to derive a daily customer identifier without storing the request IP.
QUOTA_HMAC_SECRET=

# Keep five requests in reserve under OpenRouter's current 50/day free limit.
REPORT_GLOBAL_DAILY_LIMIT=45
